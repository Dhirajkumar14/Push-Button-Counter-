#include <LiquidCrystal.h>
LiquidCrystal lcd (7,6,5,4,3,2);
int buttonPin=9;
int buttonState=0;
int lastButtonState=0;
int count=0;
void setup()
{
  pinMode(buttonPin,INPUT);
  lcd.begin(16,2);
  lcd.print("Button Counter");
}
void loop()
{
  buttonState= digitalRead(buttonPin);
  if (buttonState == HIGH &&
      lastButtonState == LOW )
  {
    count++;
  }
  lcd.setCursor (0,1);
  lcd.print("count");
  lcd.print(count);
  delay(100);
  
  lastButtonState = buttonState ;
}
